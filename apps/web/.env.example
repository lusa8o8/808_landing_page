# Browser-visible URL of the existing Supabase LTV Edge Function.
NEXT_PUBLIC_SUPABASE_FUNCTION_URL=http://localhost:54321/functions/v1/ltv-agent

# Server/build-time indexing release gate. Keep false for local and Vercel Preview builds.
# Set true only in Vercel Production after the documented SEO release checks pass.
SITE_INDEXING_ENABLED=false

# Server-side Edge Function configuration is managed with `supabase secrets set`, not here:
# LTV_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,https://www.eightzeroeight.online,https://808-landing-page-web.vercel.app
# LTV_RATE_LIMIT_BURST=20
# LTV_RATE_LIMIT_BURST_SECONDS=600
# LTV_RATE_LIMIT_DAILY=60
# LTV_RATE_LIMIT_GLOBAL_DAILY=500
# LTV_RATE_LIMIT_SALT=<server-generated secret; never commit>
